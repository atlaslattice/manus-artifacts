{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlaslattice.local/schemas/continuity/vault-receipt.schema.json",
  "title": "Continuity OS Vault Receipt",
  "description": "Verification receipt for raw sources, simulated writes, repo writes, and post-write fetch checks. A receipt records evidence; it does not approve, ratify, deploy, or grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_type",
    "created_at",
    "repository",
    "branch",
    "paths",
    "source_refs",
    "hash_status",
    "verification_status",
    "canon_status",
    "deployment_status",
    "authority_scope",
    "next_action"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "continuity.vault_receipt.v0.1" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "receipt_type": {
      "type": "string",
      "enum": ["raw_source", "parsed_packet", "dry_run_write_plan", "repo_write", "post_write_fetch", "verification_bundle"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "branch": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "path_status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "path_status": { "type": "string", "enum": ["planned", "written", "fetched", "missing", "simulated"] },
          "file_sha": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "hash_status": { "type": "string", "enum": ["present", "unavailable", "not_applicable"] },
          "notes": { "type": "string" }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_ref" }
    },
    "hash_status": { "type": "string", "enum": ["present", "unavailable", "not_applicable"] },
    "hash_method": { "type": "string", "enum": ["sha256", "git_blob_sha", "both", "none", "unknown"], "default": "unknown" },
    "hash_source_scope": {
      "type": "string",
      "enum": ["full_raw", "partial_raw", "normalized_text", "repo_file", "simulated_write_plan", "not_applicable", "unknown"],
      "default": "unknown"
    },
    "verification_status": {
      "type": "string",
      "enum": ["not_checked", "simulated", "fetch_verified", "hash_verified", "mismatch", "blocked"]
    },
    "verification_method": {
      "type": "string",
      "enum": ["none", "schema_validation", "github_fetch", "hash_compare", "manual_review", "dry_run_simulation"],
      "default": "none"
    },
    "canon_status": { "type": "string", "enum": ["not_canon", "candidate", "ratified", "rejected"], "default": "not_canon" },
    "deployment_status": { "type": "string", "enum": ["not_deployable", "local_dry_run_only", "deployed"], "default": "not_deployable" },
    "authority_scope": { "type": "string", "enum": ["none", "advisory", "review", "approved_write_only", "execution"], "default": "none" },
    "summary": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" }, "default": [] },
    "next_action": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "ref_type"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "ref_type": {
          "type": "string",
          "enum": ["user_prompt", "repo_file", "commit", "issue", "pull_request", "web", "model_output", "tool_result", "drive_file", "notion_page", "uploaded_file", "memory", "other"]
        },
        "uri": { "type": "string" },
        "commit_sha": { "type": "string" },
        "file_sha": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "raw_export_status": { "type": "string", "enum": ["full_raw", "partial_raw", "summary_only", "unavailable", "redacted"] },
        "notes": { "type": "string" }
      }
    }
  }
}
