{
  "schema_version": "0.1",
  "taxonomy": [
    {
      "type": "doctrine",
      "description": "Immutable principles and constitutional rules"
    },
    {
      "type": "spec",
      "description": "Technical specifications and protocol definitions"
    },
    {
      "type": "schema",
      "description": "Machine-readable validation schemas"
    },
    {
      "type": "registry",
      "description": "Machine-readable artifact index and relationships"
    },
    {
      "type": "blueprint",
      "description": "Project and system architecture plans"
    },
    {
      "type": "log",
      "description": "Execution, audit, and session logs"
    },
    {
      "type": "dream",
      "description": "Compressed simulation or dream outputs"
    },
    {
      "type": "seed",
      "description": "Structured ingest seed data"
    },
    {
      "type": "guide",
      "description": "Contributor and onboarding guidance"
    },
    {
      "type": "evidence",
      "description": "Structured evidence records for AI/system claims"
    },
    {
      "type": "receipt",
      "description": "Execution and validation receipts tied to work logs"
    },
    {
      "type": "roadmap",
      "description": "Wave/task campaign plans and sequencing boards"
    },
    {
      "type": "readme",
      "description": "Primary package or subsystem entrypoint documentation"
    },
    {
      "type": "archive",
      "description": "Archival collection or project corpus"
    },
    {
      "type": "manifest",
      "description": "Manifest or generated package inventory"
    },
    {
      "type": "protocol",
      "description": "Operational protocol or execution contract"
    },
    {
      "type": "index",
      "description": "Navigation index or curated directory surface"
    },
    {
      "type": "test",
      "description": "Executable validation or adversarial test surface"
    },
    {
      "type": "adr",
      "description": "Architecture decision record"
    },
    {
      "type": "report",
      "description": "Generated health, coverage, or status report"
    }
  ],
  "lifecycle_states": [
    "DRAFT",
    "CANDIDATE",
    "RATIFIED",
    "ARCHIVED",
    "DEPRECATED"
  ],
  "required_metadata_fields": [
    "id",
    "title",
    "artifact_type",
    "status",
    "path",
    "links"
  ],
  "id_format": {
    "pattern": "^AL-[A-Z]+-[0-9]{3}$",
    "description": "Stable artifact ID format: AL-<DOMAIN>-<SEQ>"
  },
  "id_domain_prefixes": [
    {
      "domain": "MISSION",
      "description": "Mission doctrine/alignment artifacts"
    },
    {
      "domain": "KG",
      "description": "Knowledge-graph schema/registry contracts"
    },
    {
      "domain": "AF",
      "description": "Aetherforge artifacts"
    },
    {
      "domain": "GP",
      "description": "GPTDream++ package artifacts"
    },
    {
      "domain": "RT",
      "description": "Ratification/trust artifacts"
    },
    {
      "domain": "CI",
      "description": "Automation and validation artifacts"
    },
    {
      "domain": "EXEC",
      "description": "Execution boards and sprint artifacts"
    },
    {
      "domain": "GOV",
      "description": "Governance baseline artifacts"
    },
    {
      "domain": "EVID",
      "description": "Evidence ledger/schema artifacts"
    },
    {
      "domain": "LOG",
      "description": "Execution receipts and logs"
    },
    {
      "domain": "SYS",
      "description": "System implementation and subsystem documentation"
    },
    {
      "domain": "BRAIN",
      "description": "Multi-agent brain manifests, protocols, and indexes"
    },
    {
      "domain": "SCHEMA",
      "description": "Schema suites and validation bundles"
    },
    {
      "domain": "TEST",
      "description": "Test harnesses and adversarial suites"
    },
    {
      "domain": "ADR",
      "description": "Architecture decision records"
    },
    {
      "domain": "HEALTH",
      "description": "Health and metadata coverage reporting artifacts"
    }
  ],
  "relation_vocabulary": [
    "defines",
    "implements",
    "implemented_by",
    "extends",
    "operationalizes",
    "governs",
    "supports",
    "constrains",
    "validated_by",
    "indexes",
    "references",
    "referenced_by",
    "depends_on",
    "summarized_by",
    "prioritizes",
    "runs",
    "validates",
    "receipts_for",
    "evidence_for",
    "recorded_in",
    "part_of",
    "relates_to",
    "tested_by",
    "tests",
    "generated_by",
    "spec"
  ],
  "lifecycle_transitions": [
    {
      "from": "DRAFT",
      "to": "CANDIDATE"
    },
    {
      "from": "CANDIDATE",
      "to": "RATIFIED"
    },
    {
      "from": "CANDIDATE",
      "to": "DEPRECATED"
    },
    {
      "from": "RATIFIED",
      "to": "ARCHIVED"
    },
    {
      "from": "RATIFIED",
      "to": "DEPRECATED"
    }
  ],
  "lifecycle_transition_guards": [
    "RATIFIED requires council ratification and @atlaslattice adjudication.",
    "ARCHIVED artifacts retain stable IDs and provenance.",
    "DEPRECATED artifacts remain addressable and should point to replacement artifacts when possible."
  ]
}
