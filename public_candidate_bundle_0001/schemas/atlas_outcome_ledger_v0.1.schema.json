{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlaslattice/manus-artifacts/tree/master/public_candidate_bundle_0001/schemas/atlas_outcome_ledger_v0.1.schema.json",
  "title": "Atlas outcome ledger v0.1",
  "description": "Additive public-candidate schema; no realized credits implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "as_of",
    "baseline_commit",
    "status",
    "realized_credit_total",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "baseline_commit": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PUBLIC_CANDIDATE_NON_CANON"
    },
    "realized_credit_total": {
      "type": "number",
      "const": 0,
      "description": "Schema pilot version: realized credits stay zero until a separately reviewed approved upgrade."
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "domain",
        "indicator_name",
        "unit",
        "direction",
        "spatial_boundary",
        "time_period",
        "population_or_asset",
        "counterfactual",
        "baseline_value",
        "scenario_value",
        "observed_value",
        "evidence_class",
        "evidence_refs",
        "primary_receipt",
        "gate",
        "credit"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "domain": {
          "enum": [
            "FINANCIAL",
            "RESILIENCE",
            "QOL",
            "ECOLOGY",
            "GRV",
            "RESOURCE",
            "GOVERNANCE"
          ]
        },
        "indicator_name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "HIGHER_BETTER",
            "LOWER_BETTER",
            "TARGET_RANGE",
            "DESCRIPTIVE"
          ]
        },
        "spatial_boundary": {
          "type": "string",
          "minLength": 1
        },
        "time_period": {
          "type": "string",
          "minLength": 1
        },
        "population_or_asset": {
          "type": "string",
          "minLength": 1
        },
        "counterfactual": {
          "type": "string",
          "minLength": 1
        },
        "baseline_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "scenario_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "observed_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "evidence_class": {
          "enum": [
            "MEASURED",
            "OFFICIAL_POLICY",
            "REGULATORY_APPROVED",
            "PROJECT_REPORTED",
            "PEER_REVIEWED_MODEL",
            "MODELED",
            "SYNTHETIC",
            "PROPOSED",
            "UNKNOWN",
            "QUARANTINED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "primary_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lower": {
              "type": [
                "number",
                "null"
              ]
            },
            "upper": {
              "type": [
                "number",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "attribution_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "allocation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "review_authority_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "BLOCKED",
                "CONDITIONAL",
                "PASSED"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "review_authority_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "credit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "unit",
            "approved",
            "approval_ref"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "const": 0
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "approved": {
              "const": false
            },
            "approval_ref": {
              "type": "null"
            }
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "MEASURED"
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "number"
              },
              "primary_receipt": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_class": {
                "enum": [
                  "UNKNOWN",
                  "PROPOSED",
                  "SYNTHETIC",
                  "QUARANTINED"
                ]
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "properties": {
              "observed_value": {
                "type": "null"
              }
            }
          }
        }
      ],
      "x-atlas-invariants": [
        "Do not identify modeled scenario as observation.",
        "A passed gate is never by itself evidence of a realized project benefit.",
        "Veto outcomes cannot be offset by QOL score or financial return.",
        "Metric ID must be unique within ledger; enforced by future cross-record validator."
      ]
    }
  },
  "x-atlas-invariants": [
    "This v0.1 pilot schema deliberately requires all realized credits to be zero.",
    "No alteration to recovered simulation or its 23 DAR items.",
    "Evidence and value domains are orthogonal.",
    "COUNTERFACTUAL is mandatory even where UNKNOWN."
  ]
}
